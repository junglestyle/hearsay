<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Hearsay records audio from your Omi pendant over Bluetooth.</string>
    <!-- Location: where conversations happened (Location.swift). Only places
         the owner names reach the stream, never coordinates. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Hearsay notes where you are while it records, so conversations can say which place you named they happened at.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Hearsay records in the background, so it needs your location then too: a fix every few minutes while you're on the move, and almost none while you stay put.</string>
    <!-- Core Motion: walking, driving or still (Location.swift), so fixes are
         only taken when they could say something new. -->
    <key>NSMotionUsageDescription</key>
    <string>Hearsay uses whether you're still, walking or driving to take location fixes only when you've moved, which saves battery.</string>
    <!-- Keeps the pendant connection, and recording, alive in the background;
         location lets readings continue there (allowsBackgroundLocationUpdates
         requires it). -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>location</string>
    </array>
    <!-- Uploads go to the NAS's capture receiver over plain HTTP on the
         tailnet, where WireGuard encrypts them. App Transport Security blocks
         HTTP otherwise, and its per-domain exceptions can't name an IP
         address; the app only ever connects to the capture URL in Settings. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
